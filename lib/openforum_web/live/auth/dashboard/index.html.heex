<Layouts.admin_app flash={@flash} current_scope={@current_scope} current_page={:dashboard}>
  <div class="flex flex-col gap-6 p-6">
    <%!-- Header --%>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-[1.25rem] font-bold text-[#0B2E4F]">
          Welcome back, {@current_scope.user.first_name}
        </h1>
        <p class="mt-0.5 text-[0.82rem] text-[#6B7280]">
          Here's what's happening across OpenForum today.
        </p>
      </div>

      <div class="flex flex-wrap gap-1.5">
        <span
          :for={role <- @current_scope.user.roles}
          class="rounded-full bg-[#EAF3F8] px-2.5 py-1 text-[0.7rem] font-medium text-[#1769AA]"
        >
          {role.name}
        </span>
      </div>
    </div>

    <%!-- Stat cards --%>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div
        :for={s <- @stats}
        class="rounded-xl border border-[#E5E7EB] bg-white p-5 transition hover:shadow-sm"
      >
        <div class="flex items-start justify-between">
          <div>
            <p class="text-[0.72rem] font-medium uppercase tracking-wide text-[#6B7280]">
              {s.label}
            </p>
            <p class="mt-2 text-[1.9rem] font-bold leading-none text-[#0B2E4F]">{s.value}</p>
          </div>
          <span class={["flex size-10 items-center justify-center rounded-lg", tone_classes(s.tone)]}>
            <.icon name={s.icon} class="size-5" />
          </span>
        </div>
        <p class="mt-3 text-[0.75rem] text-[#6B7280]">{s.change}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <%!-- Pending approvals --%>
      <div class="overflow-hidden rounded-xl border border-[#E5E7EB] bg-white lg:col-span-2">
        <div class="flex items-center justify-between border-b border-[#E5E7EB] px-5 py-4">
          <div>
            <h3 class="text-sm font-semibold text-[#0B2E4F]">Pending Approval</h3>
            <p class="text-[0.75rem] text-[#6B7280]">Waiting on your review</p>
          </div>
          <.link
            navigate={~p"/admin/approval-queue"}
            class="text-[0.78rem] font-medium text-[#1769AA] hover:text-[#0B2E4F]"
          >
            View all →
          </.link>
        </div>

        <ul :if={@pending_approvals != []} class="divide-y divide-[#F1F5F9]">
          <li
            :for={item <- @pending_approvals}
            class="flex items-center gap-4 px-5 py-4 hover:bg-[#F8FAFC]"
          >
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
              <.icon name="hero-document-text" class="size-4" />
            </span>

            <div class="min-w-0 flex-1">
              <p class="truncate text-[0.85rem] font-medium text-[#252525]">{item.title}</p>
              <p class="truncate text-[0.75rem] text-[#6B7280]">
                {item.category && item.category.name}
                <span :if={item.current_step}> · {item.current_step.name}</span>
                · by {full_name(item.author)}
              </p>
            </div>

            <div class="flex shrink-0 flex-col items-end gap-1">
              <span class="text-[0.72rem] text-[#6B7280]">{time_ago(item.updated_at)}</span>
              <.link
                navigate={~p"/admin/approval-queue"}
                class="rounded-md bg-[#EAF3F8] px-2.5 py-1 text-[0.72rem] font-medium text-[#1769AA] hover:bg-[#4F7FA8]/20"
              >
                Review
              </.link>
            </div>
          </li>
        </ul>

        <div :if={@pending_approvals == []} class="flex flex-col items-center gap-2 px-5 py-12">
          <span class="flex size-10 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
            <.icon name="hero-check" class="size-5" />
          </span>
          <p class="text-sm font-medium text-[#0B2E4F]">You're all caught up</p>
          <p class="text-[0.78rem] text-[#6B7280]">Nothing is waiting for your review.</p>
        </div>
      </div>

      <%!-- Recent activity --%>
      <div class="overflow-hidden rounded-xl border border-[#E5E7EB] bg-white">
        <div class="border-b border-[#E5E7EB] px-5 py-4">
          <h3 class="text-sm font-semibold text-[#0B2E4F]">Recent Activity</h3>
          <p class="text-[0.75rem] text-[#6B7280]">Latest workflow actions</p>
        </div>

        <ul :if={@recent_activity != []} class="divide-y divide-[#F1F5F9]">
          <li :for={a <- @recent_activity} class="flex gap-3 px-5 py-4">
            <span class={[
              "flex size-8 shrink-0 items-center justify-center rounded-full",
              activity_icon_classes(a.action)
            ]}>
              <.icon name={activity_icon(a.action)} class="size-4" />
            </span>
            <div class="min-w-0">
              <p class="text-[0.82rem] text-[#252525]">
                <span class="font-medium">{full_name(a)}</span>
                {activity_verb(a.action)}
                <span class="font-medium">"{a.title}"</span>
              </p>
              <p class="mt-0.5 text-[0.72rem] text-[#6B7280]">{time_ago(a.at)}</p>
            </div>
          </li>
        </ul>

        <p :if={@recent_activity == []} class="px-5 py-12 text-center text-[0.8rem] text-[#6B7280]">
          No activity yet.
        </p>
      </div>
    </div>

    <%!-- Quick actions --%>
    <div>
      <h3 class="mb-3 text-sm font-semibold text-[#0B2E4F]">Quick Actions</h3>
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        <.link
          :for={q <- @quick_actions}
          navigate={q.href}
          class="group flex items-center gap-3 rounded-xl border border-[#E5E7EB] bg-white px-4 py-3.5 transition hover:border-[#1769AA] hover:shadow-sm"
        >
          <span class="flex size-9 items-center justify-center rounded-lg bg-[#EAF3F8] text-[#1769AA] group-hover:bg-[#1769AA] group-hover:text-white">
            <.icon name={q.icon} class="size-4" />
          </span>
          <span class="text-[0.82rem] font-medium text-[#0B2E4F]">{q.label}</span>
        </.link>
      </div>
    </div>
  </div>
</Layouts.admin_app>
