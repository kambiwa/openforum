<div class="openforum-qa">
  <Layouts.unauth_app
    flash={@flash}
    current_scope={@current_scope}
    mobile_menu_open={@mobile_menu_open}
  >
    <main class="bg-[#FAFAF7]">
      <%!-- ============ SECTION 1 — HEADER ============ --%>
      <section class="relative overflow-hidden bg-[#FAFAF7]">
        <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
          <div class="absolute -right-24 -top-16 h-[320px] w-[320px] rounded-full bg-[#EAF3F8]">
          </div>
        </div>

        <div class="relative mx-auto max-w-[1280px] px-6 py-16 sm:px-8 lg:py-20">
          <div class="max-w-2xl">
            <h1 class="text-4xl font-semibold leading-[1.1] tracking-tight text-[#0B2E4F] sm:text-5xl">
              Questions and Answers
            </h1>
            <p class="mt-5 max-w-xl text-base leading-relaxed text-[#6B7280] sm:text-lg">
              The Catechism in Questions and Answers presents the Church's teaching in a more
              concentrated form, with simpler wording and fewer theological terms. Its 750
              questions and answers let you go straight to the topic you want to understand.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="#downloads"
                class="inline-flex items-center justify-center gap-2 rounded-md bg-[#1769AA] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[#0B2E4F]"
              >
                <.icon name="hero-arrow-down-tray" class="h-4 w-4" /> Download the PDFs
              </a>
              <a
                href="#online"
                class="inline-flex items-center justify-center rounded-md border border-[#4F7FA8]/40 bg-white px-6 py-3 text-sm font-medium text-[#0B2E4F] transition-colors hover:bg-[#EAF3F8]"
              >
                Read online
              </a>
            </div>
          </div>
        </div>
      </section>

      <%!-- ============ SECTION 2 — DOWNLOADS ============ --%>
      <section id="downloads" class="mx-auto max-w-[1280px] scroll-mt-20 px-6 py-16 sm:px-8">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-semibold tracking-tight text-[#0B2E4F]">Download the Catechism</h2>
          <p class="mt-3 text-base leading-relaxed text-[#6B7280]">
            Two PDF editions are available. Choose the full Catechism for in-depth study, or the
            Questions and Answers edition for a shorter, simpler read.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <article
            :for={doc <- @documents}
            class="flex flex-col gap-6 rounded-xl border border-[#E5E7EB] bg-white p-6 sm:flex-row sm:items-stretch"
          >
            <%!-- simple cover placeholder; swap for <img> once cover images are added --%>
            <div
              class={[
                "flex h-52 w-36 shrink-0 items-start rounded-md border border-[#E5E7EB] p-3 shadow-sm sm:h-56",
                doc.cover_class
              ]}
              aria-hidden="true"
            >
              <span class="text-[11px] font-medium uppercase leading-snug">{doc.cover_label}</span>
            </div>

            <div class="flex min-w-0 flex-1 flex-col">
              <h3 class="text-lg font-semibold leading-snug text-[#0B2E4F]">{doc.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#6B7280]">{doc.description}</p>
              <p class="mt-3 text-xs text-[#6B7280]">PDF · {doc.size} · {doc.pages}</p>

              <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-5">
                <a
                  href={doc.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-md bg-[#1769AA] px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-[#0B2E4F]"
                >
                  <.icon name="hero-arrow-down-tray" class="h-4 w-4" /> Download PDF
                </a>
                <a
                  href={doc.page_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-medium text-[#1769AA] hover:text-[#0B2E4F]"
                >
                  View on nak.org
                </a>
              </div>
            </div>
          </article>
        </div>
      </section>

      <%!-- ============ SECTION 3 — READ ONLINE ============ --%>
      <section id="online" class="scroll-mt-20 bg-[#EAF3F8]">
        <div class="mx-auto max-w-[1280px] px-6 py-16 sm:px-8">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-semibold tracking-tight text-[#0B2E4F]">
              Read Online or on Your Phone
            </h2>
            <p class="mt-4 text-base leading-relaxed text-[#6B7280]">
              Prefer not to download? Both Catechisms are also available on the web and as apps.
            </p>
          </div>

          <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
            <div
              :for={resource <- @online_resources}
              class="flex flex-col rounded-xl border border-[#E5E7EB] bg-white p-6"
            >
              <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[#EAF3F8]">
                <.icon name={resource.icon} class="h-5 w-5 text-[#1769AA]" />
              </div>
              <h3 class="mt-4 text-base font-semibold text-[#0B2E4F]">{resource.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[#6B7280]">
                {resource.description}
              </p>
              <div class="mt-5 flex flex-wrap gap-2">
                <a
                  :for={link <- resource.links}
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full border border-[#4F7FA8]/30 px-4 py-1.5 text-sm font-medium text-[#1769AA] transition-colors hover:bg-[#EAF3F8]"
                >
                  {link.label}
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%!-- ============ SECTION 4 — SOURCE NOTE ============ --%>
      <section class="bg-white">
        <div class="mx-auto max-w-[1280px] px-6 py-12 text-center sm:px-8">
          <p class="mx-auto max-w-2xl text-sm leading-relaxed text-[#6B7280]">
            These documents are published by the New Apostolic Church International and are
            linked from their official source at
            <a
              href={@source_url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-[#1769AA] hover:text-[#0B2E4F]"
            >
              nak.org
            </a>.
          </p>
          <.link
            navigate={~p"/knowledge"}
            class="mt-6 inline-flex items-center justify-center rounded-md border border-[#4F7FA8]/40 bg-white px-6 py-3 text-sm font-medium text-[#0B2E4F] transition-colors hover:bg-[#EAF3F8]"
          >
            Explore more knowledge
          </.link>
        </div>
      </section>
    </main>
  </Layouts.unauth_app>
</div>
