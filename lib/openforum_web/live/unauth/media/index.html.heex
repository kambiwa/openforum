<div class="openforum-media">
  <Layouts.unauth_app
    flash={@flash}
    current_scope={@current_scope}
    mobile_menu_open={@mobile_menu_open}
  >
    <main class="bg-[#FAFAF7]">
      <%!-- ============ SECTION 1 — PAGE HEADER ============ --%>
      <section class="relative overflow-hidden bg-[#FAFAF7]">
        <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
          <div class="absolute -right-24 top-0 h-[340px] w-[340px] rounded-full bg-[#EAF3F8]"></div>
          <div class="absolute right-40 top-32 h-32 w-32 rounded-full border border-[#4F7FA8]/20">
          </div>
        </div>

        <div class="relative mx-auto max-w-[1280px] px-6 py-16 sm:px-8 lg:py-20">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#1769AA]">
            Media Library
          </p>
          <h1 class="mt-4 max-w-2xl text-4xl font-semibold leading-[1.1] tracking-tight text-[#0B2E4F] sm:text-5xl">
            Learn Beyond the Written Word
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-[#6B7280] sm:text-lg">
            Approved videos, audio teachings, presentations and documents, all reviewed through the
            OpenForum approval workflow.
          </p>

          <%!-- search --%>
          <form phx-change="search" phx-submit="search" class="mt-8 max-w-xl">
            <label for="media-search" class="sr-only">Search media</label>
            <div class="relative">
              <.icon
                name="hero-magnifying-glass"
                class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#6B7280]"
              />
              <input
                id="media-search"
                type="search"
                name="query"
                value={@query}
                placeholder="Search teachings, topics or speakers"
                phx-debounce="300"
                autocomplete="off"
                class="w-full rounded-md border border-[#4F7FA8]/30 bg-white py-3 pl-12 pr-4 text-sm text-[#0B2E4F] placeholder:text-[#6B7280] focus:border-[#1769AA] focus:outline-none focus:ring-2 focus:ring-[#1769AA]/20"
              />
            </div>
          </form>
        </div>
      </section>

      <%!-- ============ SECTION 2 — FEATURED TEACHING ============ --%>
      <section :if={@featured_item} class="mx-auto max-w-[1280px] px-6 pb-16 sm:px-8">
        <div class="grid overflow-hidden rounded-xl border border-[#E5E7EB] bg-white lg:grid-cols-2">
          <div class="relative flex h-56 items-center justify-center bg-[#0B2E4F] sm:h-72 lg:h-auto">
            <div class="pointer-events-none absolute -left-10 -top-10 h-40 w-40 rounded-full bg-[#1769AA]/30">
            </div>
            <button
              type="button"
              class="relative flex h-16 w-16 items-center justify-center rounded-full bg-white/90 transition-transform hover:scale-105"
              aria-label={"Play " <> @featured_item.title}
            >
              <.icon name="hero-play" class="h-7 w-7 text-[#0B2E4F]" />
            </button>
          </div>
          <div class="flex flex-col justify-center p-8 lg:p-10">
            <span class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#B8964F]">
              Featured Teaching
            </span>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[#0B2E4F]">
              {@featured_item.title}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-[#6B7280]">
              {@featured_item.description}
            </p>
            <div class="mt-5 flex items-center gap-4 text-xs text-[#6B7280]">
              <span class="inline-flex items-center gap-1.5">
                <.icon name={type_icon(@featured_item.type)} class="h-4 w-4 text-[#1769AA]" />
                {type_label(@featured_item.type)}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <.icon name="hero-clock" class="h-4 w-4 text-[#1769AA]" />
                {@featured_item.duration}
              </span>
            </div>
            <div class="mt-7">
              <button
                type="button"
                class="inline-flex items-center justify-center gap-2 rounded-md bg-[#1769AA] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[#0B2E4F]"
              >
                <.icon name="hero-play" class="h-4 w-4" /> Watch Now
              </button>
            </div>
          </div>
        </div>
      </section>

      <%!-- ============ SECTION 3 — BROWSE LIBRARY ============ --%>
      <section class="bg-[#F4F8FB]">
        <div class="mx-auto max-w-[1280px] px-6 py-20 sm:px-8">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-semibold tracking-tight text-[#0B2E4F]">Browse the Library</h2>
            <p class="mt-4 text-base leading-relaxed text-[#6B7280]">
              Filter by format to find the resources that suit the way you learn.
            </p>
          </div>

          <%!-- category filters --%>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
            <button
              :for={category <- @content_categories}
              type="button"
              phx-click="filter"
              phx-value-category={category.id}
              aria-pressed={to_string(@active_category == category.id)}
              class={[
                "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors",
                @active_category == category.id &&
                  "border-[#0B2E4F] bg-[#0B2E4F] text-white",
                @active_category != category.id &&
                  "border-[#4F7FA8]/30 bg-white text-[#0B2E4F] hover:bg-[#EAF3F8]"
              ]}
            >
              <.icon name={category.icon} class="h-4 w-4" />
              {category.title}
            </button>
          </div>

          <p class="mt-8 text-center text-xs text-[#6B7280]" aria-live="polite">
            Showing {length(@content_items)} of {length(@all_items)} resources
          </p>

          <%!-- results grid --%>
          <div
            :if={@content_items != []}
            class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          >
            <article
              :for={item <- @content_items}
              class="group flex flex-col overflow-hidden rounded-xl border border-[#E5E7EB] bg-white transition-shadow hover:shadow-md"
            >
              <div class="relative flex h-40 items-center justify-center bg-[#EAF3F8]">
                <div class="flex h-14 w-14 items-center justify-center rounded-full bg-white shadow-sm transition-transform group-hover:scale-105">
                  <.icon name={type_icon(item.type)} class="h-6 w-6 text-[#1769AA]" />
                </div>
                <span class="absolute right-3 top-3 rounded-full bg-white px-3 py-1 text-[11px] font-medium text-[#0B2E4F]">
                  {item.duration}
                </span>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <span class="text-[11px] font-semibold uppercase tracking-[0.1em] text-[#B8964F]">
                  {item.topic}
                </span>
                <h3 class="mt-2 text-lg font-semibold text-[#0B2E4F]">{item.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-[#6B7280]">
                  {item.description}
                </p>
                <div class="mt-5 flex items-center justify-between border-t border-[#E5E7EB] pt-4">
                  <span class="text-xs text-[#6B7280]">{type_label(item.type)}</span>
                  <button
                    type="button"
                    class="inline-flex items-center gap-1 text-sm font-medium text-[#1769AA] hover:text-[#0B2E4F]"
                  >
                    Open <.icon name="hero-arrow-right" class="h-3.5 w-3.5" />
                  </button>
                </div>
              </div>
            </article>
          </div>

          <%!-- empty state --%>
          <div
            :if={@content_items == []}
            class="mx-auto mt-10 max-w-md rounded-xl border border-[#E5E7EB] bg-white p-10 text-center"
          >
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#EAF3F8]">
              <.icon name="hero-magnifying-glass" class="h-5 w-5 text-[#1769AA]" />
            </div>
            <h3 class="mt-4 text-base font-semibold text-[#0B2E4F]">No resources found</h3>
            <p class="mt-2 text-sm text-[#6B7280]">
              Try a different search term or choose another format.
            </p>
            <button
              type="button"
              phx-click="clear_filters"
              class="mt-6 inline-flex items-center justify-center rounded-md border border-[#4F7FA8]/40 bg-white px-5 py-2.5 text-sm font-medium text-[#0B2E4F] transition-colors hover:bg-[#EAF3F8]"
            >
              Clear filters
            </button>
          </div>
        </div>
      </section>

      <%!-- ============ SECTION 4 — TRUSTED MEDIA ============ --%>
      <section class="mx-auto max-w-[1280px] px-6 py-20 sm:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-semibold tracking-tight text-[#0B2E4F]">
            Media You Can Trust
          </h2>
          <p class="mt-4 text-base leading-relaxed text-[#6B7280]">
            Every video, audio teaching and document is reviewed through a configurable approval
            process before it is published.
          </p>
        </div>

        <div class="mt-14 hidden lg:block">
          <div class="grid grid-cols-5 items-start gap-4">
            <div
              :for={{step, index} <- Enum.with_index(@workflow_steps, 1)}
              class="relative flex flex-col items-center text-center"
            >
              <div
                :if={index < length(@workflow_steps)}
                class="absolute left-1/2 top-6 h-px w-full bg-[#4F7FA8]/25"
              >
              </div>
              <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-[#0B2E4F] text-sm font-semibold text-white">
                {index}
              </div>
              <.icon name={step.icon} class="mt-3 h-5 w-5 text-[#1769AA]" />
              <p class="mt-2 max-w-[9rem] text-sm font-medium text-[#0B2E4F]">{step.title}</p>
            </div>
          </div>
        </div>

        <div class="mt-10 space-y-6 lg:hidden">
          <div
            :for={{step, index} <- Enum.with_index(@workflow_steps, 1)}
            class="flex items-center gap-4"
          >
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#0B2E4F] text-sm font-semibold text-white">
              {index}
            </div>
            <.icon name={step.icon} class="h-5 w-5 shrink-0 text-[#1769AA]" />
            <p class="text-sm font-medium text-[#0B2E4F]">{step.title}</p>
          </div>
        </div>
      </section>

      <%!-- ============ SECTION 5 — CTA ============ --%>
      <section class="bg-[#0B2E4F]">
        <div class="mx-auto max-w-[1280px] px-6 py-20 text-center sm:px-8">
          <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Have a teaching to share?
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-white/75">
            Authorized contributors can submit audio, video, presentations and documents for review
            and publication.
          </p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
            <.link
              navigate={~p"/users/log-in"}
              class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-sm font-medium text-[#0B2E4F] transition-colors hover:bg-[#EAF3F8]"
            >
              Sign In to Contribute
            </.link>
            <.link
              navigate={~p"/knowledge"}
              class="inline-flex items-center justify-center rounded-md border border-white/30 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-white/10"
            >
              Explore Knowledge
            </.link>
          </div>
        </div>
      </section>
    </main>
  </Layouts.unauth_app>
</div>