<div class="openforum-publications">
  <Layouts.unauth_app
    flash={@flash}
    current_scope={@current_scope}
    mobile_menu_open={@mobile_menu_open}
  >
    <main class="min-h-[calc(100vh-5rem)] bg-[#FAFAF7]">
      <section class="relative overflow-hidden border-b border-[#C9A227]/60 bg-[#0B2E4F]">
        <div
          class="pointer-events-none absolute -right-16 -top-24 size-[26rem] rounded-full border border-white/10"
          aria-hidden="true"
        >
        </div>
        <div
          class="pointer-events-none absolute -right-4 -top-12 size-[20rem] rounded-full border border-[#C9A227]/25"
          aria-hidden="true"
        >
        </div>
        <header class="relative mx-auto max-w-[1440px] px-5 py-16 sm:px-8 lg:px-12 lg:py-20">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#D8B746]">
            Explore the library
          </p>
          <h1 class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-white sm:text-5xl">
            Publications
          </h1>
          <p class="mt-4 max-w-xl text-base leading-7 text-white/75">
            Browse approved documents by topic.
          </p>
        </header>
      </section>
      <section class="mx-auto max-w-[1440px] px-5 py-12 sm:px-8 lg:px-12 lg:py-16">
        <div
          class="flex flex-wrap gap-2"
          role="group"
          aria-label="Filter publications by topic"
        >
          <button
            type="button"
            phx-click="filter_category"
            phx-value-category="all"
            aria-pressed={@active_category == "all"}
            class={[
              "rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-200",
              @active_category == "all" && "border-[#0B2E4F] bg-[#0B2E4F] text-white",
              @active_category != "all" &&
                "border-[#4F7FA8]/30 bg-white text-[#0B2E4F] hover:bg-[#EAF3F8]"
            ]}
          >
            All
          </button>
          <button
            :for={category <- @categories}
            type="button"
            phx-click="filter_category"
            phx-value-category={category.id}
            aria-pressed={@active_category == Integer.to_string(category.id)}
            class={[
              "rounded-full border px-4 py-2 text-sm font-medium transition-colors duration-200",
              @active_category == Integer.to_string(category.id) &&
                "border-[#0B2E4F] bg-[#0B2E4F] text-white",
              @active_category != Integer.to_string(category.id) &&
                "border-[#4F7FA8]/30 bg-white text-[#0B2E4F] hover:bg-[#EAF3F8]"
            ]}
          >
            {category_label(category)}
          </button>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <article
            :for={document <- @documents}
            id={"publication-#{document.id}"}
            class="group flex min-h-[280px] flex-col border border-[#DDE4E8] bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-[#9AB8CB] hover:shadow-[0_16px_35px_rgba(11,46,79,0.08)]"
          >
            <div class="flex items-center justify-between">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#EAF3F8]">
                <.icon name={category_icon(document.category)} class="size-5 text-[#1769AA]" />
              </div>
              <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
                Published
              </span>
            </div>

            <p class="mt-5 text-xs font-medium text-[#6B7280]">
              {category_label(document.category)}
            </p>
            <h2 class="mt-1 text-lg font-semibold leading-snug text-[#0B2E4F]">
              {document.title}
            </h2>
            <p
              :if={document.summary not in [nil, ""]}
              class="mt-2 flex-1 text-sm leading-relaxed text-[#64748B]"
            >
              {document.summary}
            </p>
            <div class="mt-5 flex items-center justify-between border-t border-[#E1E5E9] pt-4">
              <span class="text-xs text-[#6B7280]">
                <%= if document.published_at do %>
                  {Calendar.strftime(document.published_at, "%d %b %Y")}
                <% end %>
              </span>
              <div class="flex items-center gap-4">
                <a
                  href={~p"/publications/#{document.id}/preview"}
                  target="_blank"
                  class="inline-flex items-center gap-1 text-sm font-medium text-[#1769AA] transition-colors hover:text-[#0B2E4F]"
                >
                  Preview <.icon name="hero-eye" class="size-4" />
                </a>
                <a
                  href={~p"/publications/#{document.id}/preview?download=true"}
                  class="inline-flex items-center gap-1 text-sm font-medium text-[#1769AA] transition-colors hover:text-[#0B2E4F]"
                >
                  Download PDF <.icon name="hero-arrow-down-tray" class="size-4" />
                </a>
              </div>
            </div>
          </article>
        </div>

        <p
          :if={@documents == []}
          class="mt-10 border border-dashed border-[#CBD5E1] bg-white/70 px-6 py-12 text-center text-sm text-[#64748B]"
        >
          No published documents are available in this topic yet.
        </p>
      </section>
    </main>
  </Layouts.unauth_app>
</div>
